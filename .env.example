APP_ENV=local

# KNP API
KNP_BASE_URL=https://api.knp.example.com
KNP_API_KEY=your_knp_api_key

# KNP Models
KNP_CHAT_MODEL=knp-chat-1
KNP_IMAGE_MODEL=knp-image-1
KNP_TTS_MODEL=knp-tts-1
KNP_VIDEO_MODEL=knp-video-1

# Video task API configuration
KNP_VIDEO_CREATE_PATH=/v1/video/create
KNP_VIDEO_STATUS_PATH=/v1/video/status/{task_id}
KNP_VIDEO_STATUS_FIELD=status
KNP_VIDEO_URL_FIELD=output.url
KNP_VIDEO_ERROR_FIELD=error.message
KNP_VIDEO_DONE_VALUE=completed
KNP_VIDEO_FAILED_VALUE=failed
KNP_VIDEO_POLL_INTERVAL_SECONDS=5
KNP_VIDEO_MAX_POLL_ATTEMPTS=24

# Autoclip flags
AUTO_VIDEO=true
FALLBACK_TO_IMAGE_CLIP=true

# Clip defaults
SECONDS_PER_SCENE=8
